                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Matrix (edición actualizada)\",\n  \"director\": \"Lana y Lilly Wachowski\",\n  \"genero\": \"Ciencia ficción\",\n  \"duracionMinutos\": 136,\n  \"anioEstreno\": 1999\n}"
            },
            "url": "{{baseUrl}}/api/peliculas/{{id}}"
          }
        },
        {
          "name": "Estrenos entre 2000 y 2010",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/peliculas/estrenos?desde=2000&hasta=2010"
          }
        },
        {
          "name": "Eliminar por id",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/peliculas/{{id}}"
          }
        }
