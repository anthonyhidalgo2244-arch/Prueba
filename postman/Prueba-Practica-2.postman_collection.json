              "raw": "{\n  \"titulo\": \"Matrix\",\n  \"director\": \"Lana y Lilly Wachowski\",\n  \"genero\": \"Ciencia ficción\",\n  \"duracionMinutos\": 136,\n  \"anioEstreno\": 1999\n}"
